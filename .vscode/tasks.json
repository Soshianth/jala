{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build cal-fa",
            "type": "shell",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-O2",
                "-g",
                "-o",
                "cal-fa",
                "cal-fa.cpp"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "run cal-fa",
            "type": "shell",
            "command": "./cal-fa",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "build cal-fa"
            ],
            "problemMatcher": [],
            "group": "build"
        }
    ]
}
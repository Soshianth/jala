# ===================================================================
# C++ .gitignore
# ===================================================================
# Created by https://github.com/github/gitignore/blob/main/C%2B%2B.gitignore

# پیش‌نیازها
*.d

# فایل‌های آبجکت کامپایل‌شده
*.slo
*.lo
*.o
*.obj

# هدرهای پیش‌کامپایل‌شده
*.gch
*.pch

# کتابخانه‌های داینامیک کامپایل‌شده
*.so
*.dylib
*.dll

# فایل‌های ماژول فورترن
*.mod
*.smod

# کتابخانه‌های استاتیک کامپایل‌شده
*.lai
*.la
*.a
*.lib

# فایل‌های اجرایی
*.exe
*.out
*.app
jala

# ===================================================================
# Visual Studio Code .gitignore
# ===================================================================
# Created by https://github.com/github/gitignore/blob/main/Global/VisualStudioCode.gitignore

# پوشه‌ی تنظیمات VS Code (به‌جز فایل‌های مهم پروژه)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# تاریخچه‌ی محلی VS Code
.history/

# فایل‌های سواپ و پشتیبان
*.swp
*~
*.bak

# ===================================================================
# پوشه‌های ساخت (Build)
# ===================================================================
build/
build-*/
cmake-build-*/

# ===================================================================
# فایل‌های سیستم‌عامل
# ===================================================================
.DS_Store
Thumbs.db

# ===================================================================
# clangd
# ===================================================================
.cache/
compile_commands.json

# ===================================================================
# Debian packaging (build artifacts)
# ===================================================================
debian/files
debian/*.substvars
debian/*.debhelper
debian/debhelper-build-stamp
debian/.debhelper/
debian/jala/
debian/tmp/
../*.deb
../*.buildinfo
../*.changes
../*.dsc
../*.tar.*

# ===================================================================
# Release artifacts (uploaded to GitHub Releases, not tracked)
# ===================================================================
jala-v*-linux-x86_64
jala-v*-linux-x86_64.tar.gz
jala_*.deb

# Object files in src/
src/*.o

# Auto-generated from data/holidays.json by scripts/embed_holidays.py
# and scripts/neutralize_overrides.py. Rebuild with `make holidays`.
src/holidays_data.hpp
data/overrides.json

# Unit test binary
tests/jalali_test

# ===================================================================
# JetBrains IDEs (CLion, IntelliJ)
# ===================================================================
.idea/
*.iml
cmake-build-*/
